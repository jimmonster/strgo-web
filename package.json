{
  "name": "strgo-optical-homepage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "build": "python3 build.py",
    "build:production": "npm run prepare:vendor && python3 build.py --require-vendor",
    "dev": "node scripts/preview.mjs",
    "dev:image": "STRGO_IMAGE_API=1 node scripts/preview.mjs",
    "image:icons": "node scripts/image-icons.mjs",
    "test:image": "node --test tests/image-playground.test.mjs tests/reference-image.test.mjs && python3 -m unittest discover -s tests -p 'test_image_*.py' -v",
    "test:image:browser": "node tests/image-browser.mjs",
    "test:workflow:browser": "node tests/local-studio-browser.mjs",
    "test:content:browser": "node tests/content-browser.mjs",
    "test": "node --test tests/*.test.mjs tests/image-playground.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "node tests/browser-check.mjs",
    "test:scenes:browser": "node tests/scenes-browser.mjs",
    "preview:scenes:offscreen": "node tests/export-scene-previews.mjs && python3 tests/render-scene-previews.py",
    "test:gpu": "node tests/record-particles.mjs && python3 tests/render-particles.py",
    "test:ai": "node --test tests/ai-workspace.test.mjs && python3 -m unittest discover -s tests -p \"test_ai_*.py\" -v",
    "test:admin:browser": "node tests/admin-browser.mjs"
  },
  "dependencies": {
    "@studio-freight/lenis": "1.0.42",
    "@types/three": "0.160.0",
    "canvas-confetti": "1.9.3",
    "clsx": "2.1.1",
    "framer-motion": "12.6.2",
    "gsap": "3.13.0",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "three": "0.160.1"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "playwright-core": "1.59.1",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.17"
  }
}
