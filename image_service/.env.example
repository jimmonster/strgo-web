# Copy to /etc/strgo-image.env on the Alibaba Cloud ECS host; chmod 600.
# Never place this file, real keys, the database, or pending images under dist/.
IMAGE_PUBLIC_ORIGIN=https://strgo.com
IMAGE_PORT=8092
IMAGE_DATA_DIR=/var/lib/strgo-image
# Use the existing ECS disk. No OSS account, Bucket or AccessKey is required.
IMAGE_STORAGE=local
# Optional custom files directory, otherwise IMAGE_DATA_DIR/files is used.
# IMAGE_FILES_DIR=/var/lib/strgo-image/files
# Reserve 256 MiB before starting any billable generation.
IMAGE_MIN_FREE_MB=256
IMAGE_ENV=production
# Generate with: python3 -m image_service.cli key
# Keep an offline copy. Losing this key prevents configuration/backup recovery.
IMAGE_ENCRYPTION_KEY=

# Independent admin portal. Uses existing image accounts, a separate session
# cookie, and an isolated local GPU queue; no paid provider configuration needed.
LOCAL_STUDIO_ORIGIN=https://workflow.strgo.com
# Generate a separate random token, at least 32 characters. Put the same value
# in the PC's private .local-studio/.env; never put it in frontend files.
LOCAL_STUDIO_WORKER_TOKEN=
# Use the SAME name as AI nodes when these services use the same physical GPU.
# Complete/failed jobs retain this lock until the connector verifies idle/unload.
LOCAL_STUDIO_RESOURCE_GROUP=local-studio-gpu
# Stop claiming jobs before operator maintenance / verified manual lock release.
LOCAL_STUDIO_DRAINING=0

# Optional private services, fixed IP and exact base URLs only (comma-separated).
# Access through WireGuard/Tailscale; never expose Ollama/ACE ports publicly.
# Services on the same GPU must share one resource group in the AI admin UI.
AI_LOCAL_ENDPOINTS=
# Example: http://100.64.0.2:11434,http://100.64.0.2:8001
# Keep OLLAMA_NO_CLOUD=1 on the Ollama host. No silent local-to-cloud fallback.

