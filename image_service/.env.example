# Copy to /etc/strgo-image.env on the Alibaba Cloud ECS host; chmod 600.
# Never place this file, real keys, the database, or pending images under dist/.
IMAGE_PUBLIC_ORIGIN=https://strgo.com
IMAGE_PORT=8092
IMAGE_DATA_DIR=/var/lib/strgo-image
# Use the existing ECS disk. No OSS account, Bucket or AccessKey is required.
IMAGE_STORAGE=local
# Optional custom files directory, otherwise IMAGE_DATA_DIR/files is used.
# IMAGE_FILES_DIR=/var/lib/strgo-image/files
# Reserve 256 MiB before starting any billable generation.
IMAGE_MIN_FREE_MB=256
IMAGE_ENV=production
# Generate with: python3 -m image_service.cli key
# Keep an offline copy. Losing this key prevents configuration/backup recovery.
IMAGE_ENCRYPTION_KEY=

