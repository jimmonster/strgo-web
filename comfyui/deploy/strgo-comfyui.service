[Unit]
Description=STRGO ComfyUI CPU orchestrator
After=network-online.target
Wants=network-online.target

[Service]
User=strgo-comfyui
Group=strgo-comfyui
WorkingDirectory=/opt/strgo-comfyui/current/engine
LoadCredential=engine.token:/etc/strgo-comfyui/engine.token
LoadCredential=providers.json:/etc/strgo-comfyui/providers.json
Environment=OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 HF_HUB_OFFLINE=1
ExecStart=/opt/strgo-comfyui/current/venv/bin/python main.py --cpu --listen 127.0.0.1 --port 8188 --disable-auto-launch --cache-none --disable-all-custom-nodes --whitelist-custom-nodes strgo_api_only --max-upload-size 17 --input-directory /var/lib/strgo-comfyui/engine/input --output-directory /var/lib/strgo-comfyui/engine/output --temp-directory /var/lib/strgo-comfyui/engine/temp --user-directory /var/lib/strgo-comfyui/engine/user --database-url sqlite:////var/lib/strgo-comfyui/engine/comfy.sqlite3
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
MemoryHigh=1120M
MemoryMax=1400M
CPUQuota=100%
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/strgo-comfyui/engine

[Install]
WantedBy=multi-user.target
