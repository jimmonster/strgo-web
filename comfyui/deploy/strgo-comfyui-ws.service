[Unit]
Description=STRGO ComfyUI HTTP and WebSocket gateway
After=network-online.target strgo-image.service strgo-comfyui.service
Wants=strgo-image.service strgo-comfyui.service

[Service]
User=strgo-comfyui-web
Group=strgo-comfyui
WorkingDirectory=/opt/strgo-comfyui/current/gateway
LoadCredential=engine.token:/etc/strgo-comfyui/engine.token
LoadCredential=account.token:/etc/strgo-comfyui/account.token
LoadCredential=providers.json:/etc/strgo-comfyui/providers.json
ExecStart=/opt/strgo-comfyui/current/venv/bin/python -m comfyui.gateway
Restart=on-failure
RestartSec=3
MemoryHigh=96M
MemoryMax=160M
CPUQuota=50%
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/strgo-comfyui/gateway

[Install]
WantedBy=multi-user.target
