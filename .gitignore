# Local runtime data and secrets
**/.env
**/.env.*
!**/.env.example
**/*.sqlite3
**/*.sqlite3-*
**/*.fernet
**/.image-data/
**/.image-venv/
**/.local-studio/

# Local archives and logs
**/*.zip
**/*.log
.DS_Store
